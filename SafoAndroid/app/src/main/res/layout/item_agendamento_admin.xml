<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="@android:color/white"
    android:elevation="4dp">

    <TextView
        android:id="@+id/tvClienteNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cliente: Nome"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvQuadraNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quadra: Nome da Quadra"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvHorario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horário: 00/00/0000 00:00"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: PENDENTE"
        android:textStyle="bold"
        android:textColor="#FF9800"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnAprovar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aprovar"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnRecusar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recusar"
            android:backgroundTint="#F44336"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>