package com.safo.safoapi.controller;

import com.safo.safoapi.model.Quadra;
import com.safo.safoapi.repository.QuadraRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/quadras")
public class QuadraController {

    @Autowired
    private QuadraRepository quadraRepository;

    @GetMapping
    public List<Quadra> listarTodas() {
        return quadraRepository.findAll();
    }

    @GetMapping("/{id}")
    public ResponseEntity<Quadra> buscarPorId(@PathVariable Long id) {
        return quadraRepository.findById(id)
                .map(ResponseEntity::ok)
                .orElse(ResponseEntity.notFound().build());
    }

    @PostMapping
    public Quadra criar(@RequestBody Quadra quadra) {
        return quadraRepository.save(quadra);
    }

    @PutMapping("/{id}")
    public ResponseEntity<Quadra> atualizar(@PathVariable Long id, @RequestBody Quadra quadraDetalhes) {
        return quadraRepository.findById(id)
                .map(quadra -> {
                    quadra.setNome(quadraDetalhes.getNome());
                    quadra.setTipoEsporte(quadraDetalhes.getTipoEsporte());
                    quadra.setPrecoHora(quadraDetalhes.getPrecoHora());
                    Quadra atualizada = quadraRepository.save(quadra);
                    return ResponseEntity.ok(atualizada);
                })
                .orElse(ResponseEntity.notFound().build());
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Object> deletar(@PathVariable Long id) {
        return quadraRepository.findById(id)
                .map(quadra -> {
                    quadraRepository.delete(quadra);
                    return ResponseEntity.noContent().build();
                })
                .orElse(ResponseEntity.notFound().build());
    }
}